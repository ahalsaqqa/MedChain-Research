{
  "name": "medchainmina",
  "version": "0.1.0",
  "description": "",
  "author": "",
  "license": "Apache-2.0",
  "keywords": [
    "mina-zkapp",
    "mina-zk-app",
    "mina-dapp",
    "zkapp"
  ],
  "type": "module",
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "scripts": {
    "benchmark": "npm run build && node build/src/benchmark.js",
    "demo": "npm run build && node build/src/demo.js",
    "build": "tsc",
    "buildw": "tsc --watch",
    "coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "format": "prettier --write --ignore-unknown **/*",
    "test": "npm run test:functional -- --runInBand",
    "test:functional": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathIgnorePatterns=tests/real-proofs.test.ts",
    "test:real": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --runTestsByPath tests/real-proofs.test.ts",
    "testw": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "lint": "npx eslint src/* --fix"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.16.4",
    "@babel/preset-typescript": "^7.16.0",
    "@types/jest": "^29.5.12",
    "@typescript-eslint/eslint-plugin": "^5.5.0",
    "@typescript-eslint/parser": "^5.5.0",
    "eslint": "^8.7.0",
    "eslint-plugin-o1js": "^0.4.0",
    "jest": "^29.7.0",
    "prettier": "^2.3.2",
    "ts-jest": "^29.2.4",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "o1js": "2.2.0"
  },
  "engines": {
    "node": ">=24.19.0"
  }
}
